{
  "name": "audiophile",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run build -w @audiophile/shared",
    "build:frontend": "npm run build:shared && npm run build -w frontend",
    "build:backend": "npm run build:shared && npm run build -w backend",
    "dev:shared": "npm run dev -w @audiophile/shared",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "start:frontend": "npm run start -w frontend",
    "start:backend": "npm run start -w backend"
  }
}
